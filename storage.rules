rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Project files attached to the public lead form. Visitors can add files but
    // can never read, list, or overwrite them; only signed-in admins can open them.
    // Keep the size limit and extensions in step with components/forms/FileUpload.tsx.
    match /lead-uploads/{leadId}/{fileName} {
      allow create: if resource == null
                    && request.resource.size <= 25 * 1024 * 1024
                    && fileName.lower().matches('.*[.](pdf|dwg|dxf|jpg|jpeg|png|heic|heif|webp|tif|tiff|kmz|kml|zip|csv|xls|xlsx|doc|docx)$');
      allow read, delete: if request.auth != null;
    }

    // Site image library managed from /admin/images.
    match /images/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
